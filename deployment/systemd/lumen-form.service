[Unit]
Description=LUMEN cooperation application receiver
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/lumen/current/selfhost
Environment=LUMEN_PUBLIC_ORIGIN=https://lumstrat.com
Environment=LUMEN_DB_PATH=/var/lib/lumen/applications.sqlite3
ExecStart=/var/www/lumen/current/selfhost/.venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 2 --timeout 30 --access-logfile - --error-logfile - app:application
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lumen
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
